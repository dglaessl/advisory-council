{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advisory-council.local/bridge/envelope.schema.json",
  "title": "Council task envelope",
  "description": "Every hand-off from the Chair to a seat, and every reply, uses this envelope. bridge.py enforces the same rules without third-party dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "target_seat",
    "agent",
    "objective",
    "input_context",
    "constraints",
    "permission_level",
    "expected_output",
    "done_when",
    "independent_draft",
    "reply_to"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]{1,60}-\\d{2}$",
      "description": "YYYY-MM-DD-<slug>-NN"
    },
    "target_seat": {
      "type": "string",
      "enum": [
        "chief-of-staff",
        "lead-engineer",
        "toolsmith",
        "red-team",
        "auditor",
        "venture-crew",
        "hospitality-crew",
        "career-crew",
        "field-scout"
      ]
    },
    "agent": {
      "type": "string",
      "enum": ["hermes", "openhands", "goose", "agent-zero", "crewai", "openclaw"]
    },
    "objective": { "type": "string", "minLength": 10, "maxLength": 500 },
    "input_context": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "permission_level": { "type": "string", "enum": ["R0", "R1", "R2", "R3"] },
    "expected_output": { "type": "string", "minLength": 5 },
    "done_when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "independent_draft": { "type": "boolean" },
    "reply_to": { "type": "string", "pattern": "^council/outbox/[a-z-]+/$" },
    "created_at": { "type": "string" },
    "approved_by_daniel": {
      "type": "boolean",
      "description": "Required true for any R3 task."
    }
  }
}
